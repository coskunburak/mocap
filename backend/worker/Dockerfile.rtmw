FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RTMW_BACKEND=onnxruntime \
    RTMW_DEVICE=cpu \
    RTMW_MODE=balanced

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/mocap
COPY worker/requirements.model-rtmw.txt /opt/mocap/requirements.model-rtmw.txt
RUN pip install --no-cache-dir -r /opt/mocap/requirements.model-rtmw.txt

COPY worker/model_adapters /opt/mocap/model_adapters

ENTRYPOINT ["python", "/opt/mocap/model_adapters/rtmw_detector.py"]
