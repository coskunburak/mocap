# Production GPU worker environment for RunPod or an equivalent CUDA pod.
# Do not set WHAM_PRECOMPUTED_OUTPUT_PKL in production.

NODE_ENV=production

# API/queue/storage connectivity. RunPod, the API backend, and the mobile app
# upload flow must all point at the same public Postgres database and the same
# S3-compatible bucket. Supabase is a non-AWS option for both:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
# S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_REGION=REGION_FROM_STORAGE_S3_SETTINGS
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=REGION_FROM_STORAGE_S3_SETTINGS
S3_BUCKET=mocapexpo-production
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
S3_REQUEST_TIMEOUT_MS=30000
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=600
SKIP_OBJECT_HEAD_VALIDATION=false

# Worker sizing
WORKER_POLL_INTERVAL_MS=2000
WORKER_IDLE_LOG_INTERVAL_MS=30000
WORKER_TEMP_DIR=/tmp/mocapexpo-worker
WORKER_TARGET_FPS=30
WORKER_MAX_WIDTH=1280
MAX_VIDEO_BYTES=786432000
MAX_METADATA_BYTES=1048576
MAX_VIDEO_DURATION_SECONDS=180
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Production dual-camera QA requires this in the actual RunPod worker runtime.
# Setting it only in the local API backend .env does not affect serverless jobs.
ENABLE_MULTI_VIEW_RECONSTRUCTION=true
ALLOW_PRIMARY_WHAM_FALLBACK=true

# Optional 2D pose detector used by the reconstruction branch. If disabled or
# misconfigured, the worker must report multi_view_pose_extraction_failed and
# continue primary WHAM fallback when ALLOW_PRIMARY_WHAM_FALLBACK=true.
MOCAPEXPO_POSE_DETECTOR=rtmpose_mmpose
MOCAPEXPO_RTMPOSE_CLI_PATH=/workspace/pose/rtmpose_cli.py
MOCAPEXPO_RTMPOSE_MODEL_PATH=/workspace/pose/models/rtmpose.pth
MOCAPEXPO_RTMPOSE_CONFIG_PATH=/workspace/pose/configs/rtmpose.py
MOCAPEXPO_RTMPOSE_TIMEOUT_MS=120000

# WHAM/SMPL solve. These paths must exist inside the GPU worker image/pod.
PYTHON_PATH=/opt/conda/bin/python
WHAM_SOLVER_SCRIPT=worker/model_adapters/wham_solver.py
WHAM_SOLVER_VERSION=wham_official_api_v1
WHAM_REPO_DIR=/workspace/WHAM
WHAM_CONFIG_PATH=configs/yamls/demo.yaml
WHAM_LD_LIBRARY_PATH=/opt/conda/lib/python3.9/site-packages/torch/lib:/opt/conda/lib
WHAM_ESTIMATE_LOCAL_ONLY=false
WHAM_RENDER_OVERLAY_PREVIEW=true
WHAM_ROOT_SCALE=100
WHAM_REQUIRE_CUDA=true
PREMIUM_MOTION_TIMEOUT_MS=1800000

# Asset checks performed by npm run worker:preflight:wham.
# Paths are relative to WHAM_REPO_DIR unless absolute.
WHAM_PREFLIGHT_REQUIRED_MODULES=torch,cv2,joblib,smplx,mmcv,mmpose,loguru
WHAM_PREFLIGHT_REQUIRED_PATHS=checkpoints/wham_vit_bedlam_w_3dpw.pth.tar,checkpoints/hmr2a.ckpt
WHAM_SMPL_ASSET_DIR=/workspace/WHAM/dataset/body_models/smpl

# Optional: set only if the official WHAM config expects an external calibration file.
WHAM_CALIBRATION_PATH=

# Optional operational switches
BLENDER_PATH=
REQUIRE_BLENDER_SMOKE_TEST=false
SKIP_WHAM_PREFLIGHT=false
