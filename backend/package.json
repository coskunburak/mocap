    "test:triangulation": "tsx src/worker/reconstruction/triangulation.test.ts",
    "test:pose-extraction": "tsx src/worker/pose/poseExtraction.test.ts",
    "test:frame-sync": "tsx src/worker/reconstruction/frameSync.test.ts",
    "test:camera-calibration": "tsx src/worker/reconstruction/cameraCalibration.test.ts",
    "test:multi-view-reconstruction": "tsx src/worker/reconstruction/multiViewReconstruction.test.ts",
    "test:multi-view-orchestrator": "tsx src/worker/reconstruction/multiViewOrchestrator.test.ts",
    "test:wham-input-usage": "tsx src/worker/whamInputUsage.test.ts",
