NODE_ENV=development
PORT=4010
DATABASE_URL=postgres://mocap:mocap@localhost:55432/mocapexpo
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mocapexpo-dev
S3_ACCESS_KEY_ID=mocap
S3_SECRET_ACCESS_KEY=mocapdev
S3_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=600
S3_REQUEST_TIMEOUT_MS=30000
MAX_VIDEO_BYTES=786432000
MAX_METADATA_BYTES=1048576
MAX_VIDEO_DURATION_SECONDS=180
WORKER_TARGET_FPS=30
WORKER_MAX_WIDTH=1280
WORKER_POLL_INTERVAL_MS=2000
WORKER_TEMP_DIR=/tmp/mocapexpo-worker
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PYTHON_PATH=python3
POSE_DETECTOR_SCRIPT=worker/pose_detector.py
POSE_DETECTOR_VERSION=mediapipe_pose_v1
POSE_ENGINE=auto
RTMW_DETECTOR_SCRIPT=
RTMW_DETECTOR_VERSION=rtmw_wholebody_adapter_v1
RTMW_DEVICE=cpu
RTMW_BACKEND=onnxruntime
RTMW_MODE=balanced
RTMW_MIN_SCORE=0.2
POSE_ENGINE_TIMEOUT_MS=900000
ALLOW_POSE_FALLBACK=true
MOCAP_ALLOW_SYNTHETIC_POSE=false
MOTION_SOLVER=auto
WHAM_SOLVER_SCRIPT=
WHAM_SOLVER_VERSION=wham_adapter_v1
WHAM_REPO_DIR=
WHAM_CALIBRATION_PATH=
WHAM_CONFIG_PATH=
WHAM_LD_LIBRARY_PATH=
WHAM_ESTIMATE_LOCAL_ONLY=false
WHAM_ROOT_SCALE=100
WHAM_REQUIRE_CUDA=false
WHAM_PREFLIGHT_REQUIRED_MODULES=
WHAM_PREFLIGHT_REQUIRED_PATHS=
WHAM_SMPL_ASSET_DIR=
PREMIUM_MOTION_TIMEOUT_MS=1800000
REQUIRE_PREMIUM_MOTION=false
BLENDER_PATH=
REQUIRE_BLENDER_SMOKE_TEST=false
SKIP_OBJECT_HEAD_VALIDATION=false
